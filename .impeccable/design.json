      "css": ".ds-tool{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;color:var(--text,#f0ede8);width:44px;height:44px;background:#191c24;border:1px solid var(--line,#393d49);border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:background .2s,border-color .2s}.ds-tool:hover,.ds-tool[aria-pressed=true]{background:#30313a;border-color:var(--accent,#d6bb91)}.ds-tool svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-tool:focus-visible,.ds-range:focus-visible,.ds-checkbox:focus-visible{outline:2px solid var(--accent,#d6bb91);outline-offset:5px}@media(max-width:600px){.ds-tool{width:40px;height:40px}}@media(prefers-reduced-motion:reduce){.ds-tool{transition:none!important}}"
