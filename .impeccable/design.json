      "html": "<button class=\"ds-primary\">탭하여 시작</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:16px;background:var(--accent,#d6bb91);color:#242028;border:0;border-radius:28px;min-height:50px;padding:0 32px;font-weight:600;box-shadow:0 8px 30px #0003;cursor:pointer;transition:background .2s,transform .2s}.ds-primary:hover{background:#ead2ac;transform:translateY(-2px)}.ds-primary:disabled{cursor:wait;opacity:.65;transform:none}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-tool:focus-visible,.ds-range:focus-visible,.ds-checkbox:focus-visible{outline:2px solid var(--accent,#d6bb91);outline-offset:5px}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none!important}}"
